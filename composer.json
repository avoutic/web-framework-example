{
    "name": "avoutic/web-framework-skeleton",
    "description": "WebFramework skeleton project",
    "type": "project",
    "keywords": [
        "framework",
        "security",
        "skeleton",
        "example"
    ],
    "homepage": "https://github.com/avoutic/web-framework-skeleton/",
    "license": "MIT",
    "authors": [
        {
            "name": "Avoutic",
            "email": "avoutic@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/avoutic/web-framework-skeleton/issues",
        "source": "https://github.com/avoutic/web-framework-skeleton"
    },
    "require": {
        "avoutic/web-framework": "^12",
        "avoutic/web-framework-mysql": "^5",
        "avoutic/web-framework-redis": "^4",
        "avoutic/web-framework-postmark": "^4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Actions\\": "actions/",
            "App\\Routes\\": "routes/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "framework-publish"
        ],
        "post-update-cmd": [
            "framework-publish"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    }
}
